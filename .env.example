# Domínio oficial, sem barra final (ex.: https://www.academiadamagia.com.br)
NEXT_PUBLIC_SITE_URL=

# Endpoint que recebe o POST do formulário. Para usar o Route Handler deste projeto: /api/inscricao
NEXT_PUBLIC_REGISTRATION_ENDPOINT=

# Usados pelo Route Handler /api/inscricao (server-side, nunca expostos ao navegador)
REGISTRATION_WEBHOOK_URL=
REGISTRATION_WEBHOOK_TOKEN=

# Analytics (carregados somente após consentimento — ver README)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
